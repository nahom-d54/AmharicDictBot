# Copy this file to .env and fill in the values

# Telegram bot token (required)
TG_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Optional secret if you later enable webhooks
# TG_SECRET_TOKEN=

# App port (container listens on 3000; you can map it via compose)
PORT=3000

# Mongo connection string; compose overrides to use the mongodb service by default
# For local dev without compose, you may use: mongodb://localhost:27017/telegram-bot
MONGODB_URI=mongodb://mongodb:27017/telegram-bot
TG_SECRET_TOKEN="tgsecret"
TG_BOT_TOKEN="tgbottoken"
WEBHOOK_URL="https://amharic-dictionary-bot.api.exchango.pro.et"
MONGODB_URI="mongodb://localhost:27017/amharic-dictionary-bot"
DOMAIN="amharic-dictionary-bot.api.exchango.pro.et"
PORT=3000
API_BASE_URL="https://dictionary.abyssinica.com/Services/AjaxService.svc/GetSearchResult"